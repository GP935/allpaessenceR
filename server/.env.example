# Allpa Essence — backend de pagos. Copiar a `.env` en el VPS (NUNCA commitear `.env`).

# 'none' (por defecto): el carrito sigue en modo "pago en configuración".
# 'mercadopago': activa create-order / process-payment / webhook y el Brick.
CHECKOUT_GATEWAY=none

# Access Token de PRODUCCIÓN de la aplicación de MP de Allpa (APP_USR-...). SOLO aquí.
MP_ACCESS_TOKEN=
# Clave secreta del webhook: panel de MP → Tu integración → Webhooks → "Clave secreta".
# Sin ella el webhook rechaza TODA notificación (los pagos se cobran, pero no se confirman).
MP_WEBHOOK_SECRET=

# URL pública del sitio (dominio pendiente de Paul).
# '1' activa 3DS 2.0 en modo optional (MP decide cuándo pedir verificación al banco). Por defecto apagado.
THREEDS_ENABLED=0

PUBLIC_BASE_URL=https://allpaessence.com
PORT=3000
